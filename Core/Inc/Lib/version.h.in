#ifndef INC_LIB_VERSION_H_
#define INC_LIB_VERSION_H_

// The running firmware's version, answered on the vendor interface's version
// request so the update page can show what is on the module next to the image
// it is about to write. See USBD_BMCV_Version in Core/Src/Lib/usblink.c.
//
// Nothing enforces it. Any build flashes over any other - the ROM DFU
// bootloader has no idea what a version is, and adding a policy here would only
// be a policy the recovery path ignores.
//
// Generated by CMake from ../../../VERSION - see CMakeLists.txt. Don't edit
// version.h directly (it isn't checked in); bump ../../../VERSION instead,
// normally via `cz bump` (see .cz.toml).
#define FW_VERSION_MAJOR @FW_VERSION_MAJOR@
#define FW_VERSION_MINOR @FW_VERSION_MINOR@
#define FW_VERSION_PATCH @FW_VERSION_PATCH@

#endif /* INC_LIB_VERSION_H_ */
