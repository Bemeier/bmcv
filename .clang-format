BasedOnStyle: LLVM
IndentWidth: 2
TabWidth: 2
UseTab: Never
ColumnLimit: 140
BreakBeforeBraces: Allman
AllowShortIfStatementsOnASingleLine: false
SpacesBeforeTrailingComments: 1
SpaceAfterCStyleCast: true
IncludeBlocks: Preserve
AlignConsecutiveAssignments: true
PointerAlignment: Left
SortIncludes: true
# The sim's public header wraps everything in extern "C" for C++ hosts.
# Indenting a file-wide block buys nothing and costs two columns on every line.
IndentExternBlock: NoIndent
