# The repo root's .clangd forces -std=c2x, which is right for the firmware and
# an error for the C++ here. Rack's own headers are outside the repo and their
# location is per-machine, so add yours to the Add: list below if you want
# rack.hpp to resolve - e.g. -I/home/you/Rack-SDK/include.
CompileFlags:
  Remove: [-std=c2x]
  Add:
    - -xc++
    - -std=c++11
    - -I../Core/Inc/Lib
    - -I../sim/include
    - -I../panel
